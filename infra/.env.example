
# Postgres
DB_URL=postgresql://app_user:***@your-rds-endpoint:5432/gifts
DB_POOL_MIN=1
DB_POOL_MAX=10
PG_STMT_TIMEOUT_MS=5000

# GPU endpoint (Runpod 등)
GPU_ENDPOINT_URL=https://api.runpod.ai/v2/your-endpoint
RUNPOD_API_KEY=YOUR_RUNPOD_KEY

# Gate 파라미터 
MIN_CATEGORIES=1
MAX_CATEGORIES=3
MIN_CAT_SCORE=0.10
W_INTENT_NEED=1.30
W_INTENT_PURCHASE=1.25
W_INTENT_INTEREST=1.10
W_INTENT_CONSIDER=1.15
W_INTENT_NEGATIVE=0.00
W_INTENT_INFO=0.80
W_SENT_POS=0.30
W_SENT_NEG=0.50
RECENCY_HALF_LIFE_DAYS=30

# LLM
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=YOUR_OPENAI_KEY
