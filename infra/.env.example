
# =============================================================================
# 카카오톡 선물 추천 시스템 환경 변수 설정
# =============================================================================

# =============================================================================
# 데이터베이스 설정
# =============================================================================
# PostgreSQL 연결 URL 
DB_URL=postgresql://username:password@localhost:5432/gift_recommender

# 데이터베이스 연결 풀 설정
DB_POOL_MIN=1
DB_POOL_MAX=10
PG_STMT_TIMEOUT_MS=5000

# =============================================================================
# GPU 서비스 설정 (RunPod)
# =============================================================================
# GPU 엔드포인트 URL 
GPU_ENDPOINT_URL=https://your-endpoint-id.proxy.runpod.net

# RunPod API 키 
RUNPOD_API_KEY=your_runpod_api_key_here

# =============================================================================
# LLM 서비스 설정 (OpenAI)
# =============================================================================
# LLM 제공자 (기본값: openai)
LLM_PROVIDER=openai

# LLM 모델명 (기본값: gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

# OpenAI API 키 
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# 알고리즘 가중치 설정
# =============================================================================
# 의도별 가중치 (1.0 = 기본값)
W_INTENT_NEED=1.30          # 필요 의도
W_INTENT_PURCHASE=1.25      # 구매 의도  
W_INTENT_INTEREST=1.10      # 관심 의도
W_INTENT_CONSIDER=1.15      # 고민 의도
W_INTENT_NEGATIVE=0.00      # 부정 의도 (제외)
W_INTENT_INFO=0.80          # 단순 언급

# 감정 가중치
W_SENT_POS=0.30             # 긍정 감정 가중치
W_SENT_NEG=0.50             # 부정 감정 가중치

# 시간 가중치 (일)
RECENCY_HALF_LIFE_DAYS=30   # 최근성 반감기

# 카테고리 선택 설정
MIN_CATEGORIES=1            # 최소 카테고리 수
MAX_CATEGORIES=3            # 최대 카테고리 수
MIN_CAT_SCORE=0.10          # 최소 카테고리 점수

# =============================================================================
# 개발/디버깅 설정
# =============================================================================
# 로그 레벨 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 개발 모드 (true/false)
DEBUG=false

# =============================================================================
# 서버 설정
# =============================================================================
# 서버 호스트 (기본값: 0.0.0.0)
HOST=0.0.0.0

# 서버 포트 (기본값: 8000)
PORT=8000

# =============================================================================
# 보안 설정
# =============================================================================
# CORS 허용 도메인 
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

