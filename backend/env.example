# ===== LLM 설정 =====
LLM_PROVIDER=UPSTAGE
UPSTAGE_API_KEY=your_upstage_api_key_here
UPSTAGE_BASE_URL=https://api.upstage.ai/v1
UPSTAGE_CHAT_MODEL=solar-1-mini-chat

# 병렬 처리를 위한 추가 API 키들 (선택사항)
UPSTAGE_API_KEY_1=your_second_api_key_here
UPSTAGE_API_KEY_2=your_third_api_key_here
UPSTAGE_API_KEY_3=your_fourth_api_key_here
UPSTAGE_API_KEY_4=your_fifth_api_key_here
UPSTAGE_API_KEY_5=your_sixth_api_key_here

# ===== 성능 설정 =====
MAX_CONCURRENCY=20
TIMEOUT_SECS=60

# ===== 하이퍼파라미터 =====
ENTROPY_TARGET_PARENT=0.70
ENTROPY_TARGET_CHILD=0.80
BETA=1.0
GAMMA=1.0

# ===== 인기도 점수 가중치 =====
POP_SATISFACTION_WEIGHT=0.5
POP_REVIEW_WEIGHT=0.3
POP_WISH_WEIGHT=0.2

# ===== 정규화 기준값 =====
REVIEW_COUNT_THRESHOLD=1000
WISH_COUNT_THRESHOLD=10000

# ===== 신뢰도 가중치 =====
CONFIDENCE_HIGH=1.0
CONFIDENCE_MEDIUM=0.6
CONFIDENCE_LOW=0.3

# ===== 상품 선택 가중치 =====
CATEGORY_WEIGHT=0.7
POPULARITY_WEIGHT=0.3

# ===== 싱글-차일드 가드 =====
SINGLE_CHILD_PENALTY=0.3

# ===== 캐시 설정 =====
CACHE_BACKEND=none  # redis | memory | none
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECS=1209600  # 14 days

# ===== 데이터베이스 설정 =====
DB_URL=postgresql://username:password@localhost:5432/database_name
DB_POOL_MIN=1
DB_POOL_MAX=10
PG_STMT_TIMEOUT_MS=5000

# ===== 기타 설정 =====
NEAR_DUP_THRESH=0.8
LOG_LEVEL=INFO
PORT=8000

# ===== 병렬 처리 설정 =====
INDIVIDUAL_PARALLEL_THRESHOLD=5  # 개별 병렬 처리 임계값
