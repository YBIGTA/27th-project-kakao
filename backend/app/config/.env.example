# ========================================
# Gift Recommendation API 환경변수 설정
# ========================================

# ========================================
# Upstage API 키 설정 (병렬 처리용)
# ========================================

# 기본 API 키
UPSTAGE_API_KEY=your_upstage_api_key_here

# 추가 API 키들 (병렬 처리용) - 5개 사용
UPSTAGE_API_KEY_1=your_upstage_api_key_1_here
UPSTAGE_API_KEY_2=your_upstage_api_key_2_here
UPSTAGE_API_KEY_3=your_upstage_api_key_3_here
UPSTAGE_API_KEY_4=your_upstage_api_key_4_here
UPSTAGE_API_KEY_5=your_upstage_api_key_5_here

# ========================================
# LLM 설정
# ========================================

# LLM 제공자 
LLM_PROVIDER=upstage

# LLM 모델 (현재: solar-pro 사용)
UPSTAGE_CHAT_MODEL=solar-pro

# LLM 기본 URL
UPSTAGE_BASE_URL=https://api.upstage.ai/v1

# ========================================
# 데이터베이스 설정
# ========================================

# PostgreSQL 데이터베이스 URL
DB_URL=postgresql://username:password@your-database-host:5432/database_name

# ========================================
# 서버 설정
# ========================================

# 서버 호스트 (0.0.0.0: 모든 IP에서 접근 가능)
HOST=0.0.0.0

# 서버 포트
PORT=8000

# 워커 수 (병렬 처리용)
WORKERS=1

# ========================================
# 파이프라인 설정
# ========================================

# 계층 결합 노드 설정
BETA=1.0
GAMMA=1.0
SINGLE_CHILD_PENALTY=0.3

# 엔트로피 타겟 설정
ENTROPY_TARGET_PARENT=0.70
ENTROPY_TARGET_CHILD=0.80

# ========================================
# 성능 설정
# ========================================

# API 타임아웃 설정 (초)
TIMEOUT_SECS=60
MAX_CONCURRENCY=20

# ========================================
# 캐시 설정
# ========================================

# 캐시 백엔드 (redis | memory | none)
CACHE_BACKEND=none

# Redis URL (CACHE_BACKEND=redis일 때 사용)
REDIS_URL=

# 캐시 TTL (초, 14일)
CACHE_TTL_SECS=1209600

# ========================================
# 기타 설정
# ========================================

# 중복 감지 임계값
NEAR_DUP_THRESH=0.8

# ========================================
# 사용법
# ========================================

# 1. 이 파일을 .env로 복사
# cp env_example.txt .env

# 2. 실제 값으로 수정
# - UPSTAGE_API_KEY: 실제 Upstage API 키
# - UPSTAGE_API_KEY_1~5: 추가 API 키들 (병렬 처리용)
# - DB_URL: 실제 데이터베이스 URL

# 3. 서버 실행
# python main.py
# 또는
# uvicorn main:app --host 0.0.0.0 --port 8000 --workers 4
